---
import LinkPage from '../components/LinkPage.astro';
---
<LinkPage kind="verify" heading="Confirm your email" copyLabel="Copy link" where="email" last="=" note="This link works once and expires in 24 hours. Opening this page hasn't confirmed anything yet.">
  <Fragment slot="intro">Open this link in the Mọyì app to confirm your address.</Fragment>
  <Fragment slot="by-hand">Copy this link, then open Mọyì and paste it where the app asks for the code from the email. The 6-digit code in the email works there too, for 15 minutes.</Fragment>
</LinkPage>

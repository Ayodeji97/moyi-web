---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
---
<Base title="Mọyì" fonts>
  <main>
    <Brand />
    <h1>A private gratitude journal for two.</h1>
    <p>Each of you writes one thing a day. Neither reads the other's until both have written.</p>
    <p>Not open to the public yet.</p>
  </main>
</Base>

<style>
  h1 {
    font-family: "Newsreader", ui-serif, Georgia, serif;
    font-weight: 400;
    font-size: var(--fs-title);
    line-height: 1.25;
  }
</style>

---
import Phone from './Phone.astro';
import Scene from './Scene.astro';
import StoreButtons from './StoreButtons.astro';
import '../styles/evening.css';
---
<section id="how" class="evening" aria-label="How it works">
  <div class="frame frame--hero" data-frame="1">
    <Scene name="sky-afternoon" />
    <div class="evening__hero">
      <p class="eyebrow">Daily gratitude, for two</p>
      <h1>Write before you read.</h1>
      <p class="evening__lede">One short thing about each other, every day.<br />Your day opens when you both have.</p>
      <StoreButtons />
    </div>
  </div>

  <div class="frame frame--solo" data-frame="2">
    <Scene name="sky-dusk" />
    <div class="evening__caption">
      <span class="ct">Lagos</span>
      <span class="tm">21:40</span>
      <p>Amara writes one true sentence about Tunde.</p>
    </div>
    <div class="evening__phone"><Phone view="write" time="21:40" /></div>
    <p class="evening__step">Amara writes</p>
  </div>

  <div class="frame frame--split" data-frame="3">
    <div class="evening__panes">
      <div class="evening__pane">
        <Scene name="lagos" />
        <div class="evening__who"><b>21:42</b><span>Lagos · Amara</span></div>
        <div class="evening__phone"><Phone view="wait" size="pane" time="21:42" /></div>
      </div>
      <div class="evening__pane">
        <Scene name="rain" />
        <div class="evening__who"><b>20:42</b><span>London · Tunde</span></div>
        <div class="evening__phone">
          <Phone
            view="write"
            size="pane"
            time="20:42"
            partner="Amara"
            mine="You called my mum on her birthday before I remembered."
            theirs="You waited up so I wouldn't walk home alone."
          />
        </div>
      </div>
      <div class="evening__seam" aria-hidden="true"></div>
    </div>
    <p class="evening__step">Tunde writes</p>
  </div>

  <div class="frame frame--solo" data-frame="4">
    <Scene name="sky-night" />
    <div class="evening__caption">
      <span class="ct">Lagos 23:10 · London 22:10</span>
      <p>Your day is open. Both of you, at the same moment.</p>
    </div>
    <div class="evening__phone"><Phone view="reveal" time="23:10" /></div>
    <p class="evening__step">Read together</p>
  </div>
</section>

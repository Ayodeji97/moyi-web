---
// `home` is false on every page but /, where the anchors live; elsewhere they point back to /.
const { home = true } = Astro.props as { home?: boolean };
const base = home ? '' : '/';
// On phones the centred nav is hidden and the same four links sit behind a menu toggle: a <details>,
// so it opens and closes without JavaScript (scripts/menu.ts adds closing on a link, Escape or a
// tap outside, on the home page). Above 699px the toggle is hidden and the nav shows.
// The mark's geometry is copied in TopBar.astro, Brand.astro and scripts/make-icons.sh; keep the three in sync.
---
<header class="topbar">
  <a class="brand" href="/">
    <svg viewBox="0 0 40 52" width="18" height="23" aria-hidden="true" focusable="false">
      <circle cx="20" cy="22" r="14.5" fill="none" stroke="currentColor" stroke-width="4.5"></circle>
      <circle cx="20" cy="46" r="4" fill="currentColor"></circle>
    </svg>
    Mọyì
  </a>
  <nav aria-label="Main">
    <a href={`${base}#how`}>How it works</a>
    <a href="/privacy">Privacy</a>
    <a href="/faq">FAQs</a>
    <a href="/support">Support</a>
  </nav>
  <details class="menu">
    <summary aria-label="Menu">
      <span class="menu__icon" aria-hidden="true"><i></i><i></i></span>
    </summary>
    <nav class="menu__panel" aria-label="Main">
      <a href={`${base}#how`}>How it works</a>
      <a href="/privacy">Privacy</a>
      <a href="/faq">FAQs</a>
      <a href="/support">Support</a>
    </nav>
  </details>
  <a class="get" href={`${base}#get`}>Get the app</a>
</header>

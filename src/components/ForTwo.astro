---
import '../styles/sections.css';
// Three bonds, each shown by one entry: no cards, just the sentence set large, staggered down the
// page like notes left on a table, with who wrote it underneath. Fictional names only.
// The photo and voice note follow the app's real look (docs/web-screens 6-photo, 7-voice):
// one photo and one voice note per entry at most, a voice note at most 1:00, so 0:24 is honest.
// Photo: Unsplash PyL-lApI1F8 by Mounish Raja, Unsplash License (free, no attribution required).
---
<section class="for2" data-section="for-two">
  <div class="wrap">
    <h2 class="for2__h">Whoever your one person is.</h2>
    <ul class="bonds">
      <li class="bond bond--a">
        <figure class="ent">
          <blockquote class="ent__text"><p>You stayed on the phone until I fell asleep.</p></blockquote>
          <figcaption class="ent__from">From Tunde, <span>my partner</span></figcaption>
        </figure>
      </li>
      <li class="bond bond--b">
        <figure class="ent">
          <blockquote class="ent__text"><p>You remembered my interview and had dinner waiting after.</p></blockquote>
          <img class="ent__media ent__photo" data-media="photo" src="/media/table-640.webp" srcset="/media/table-640.webp 640w, /media/table-960.webp 960w" sizes="(max-width: 699px) 260px, 280px" width="640" height="480" alt="A dinner table laid with candles, flowers and food." loading="lazy" decoding="async" />
          <figcaption class="ent__from">From Ellie, <span>my close friend</span></figcaption>
        </figure>
      </li>
      <li class="bond bond--c">
        <figure class="ent">
          <blockquote class="ent__text"><p>You still ask if I've eaten, every call.</p></blockquote>
          <div class="ent__media ent__voice" data-media="voice" role="img" aria-label="A voice note, 24 seconds, sent with the entry">
            <span class="ent__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" focusable="false"><path d="M8.5 6.5v11l9-5.5z"></path></svg></span>
            <svg class="ent__wave" viewBox="0 0 148 28" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <rect x="0" y="11" width="3" height="6" rx="1.5"></rect><rect x="7" y="8" width="3" height="12" rx="1.5"></rect><rect x="14" y="4" width="3" height="20" rx="1.5"></rect><rect x="21" y="9" width="3" height="10" rx="1.5"></rect><rect x="28" y="2" width="3" height="24" rx="1.5"></rect><rect x="35" y="7" width="3" height="14" rx="1.5"></rect><rect x="42" y="10" width="3" height="8" rx="1.5"></rect><rect x="49" y="5" width="3" height="18" rx="1.5"></rect><rect x="56" y="1" width="3" height="26" rx="1.5"></rect><rect x="63" y="6" width="3" height="16" rx="1.5"></rect><rect x="70" y="9" width="3" height="10" rx="1.5"></rect><rect x="77" y="4" width="3" height="20" rx="1.5"></rect><rect x="84" y="8" width="3" height="12" rx="1.5"></rect><rect x="91" y="11" width="3" height="6" rx="1.5"></rect><rect x="98" y="6" width="3" height="16" rx="1.5"></rect><rect x="105" y="3" width="3" height="22" rx="1.5"></rect><rect x="112" y="8" width="3" height="12" rx="1.5"></rect><rect x="119" y="10" width="3" height="8" rx="1.5"></rect><rect x="126" y="7" width="3" height="14" rx="1.5"></rect><rect x="133" y="11" width="3" height="6" rx="1.5"></rect><rect x="140" y="9" width="3" height="10" rx="1.5"></rect><rect x="145" y="12" width="3" height="4" rx="1.5"></rect>
            </svg>
            <span class="ent__clock" aria-hidden="true">0:00 of 0:24</span>
            <span class="ent__speed" aria-hidden="true">1×</span>
          </div>
          <figcaption class="ent__from">From Mum, <span>my family</span></figcaption>
        </figure>
      </li>
    </ul>
    <p class="far">Both of you 18 or over.</p>
  </div>
</section>

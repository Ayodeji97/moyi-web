---
// A generic phone, drawn in HTML and CSS, showing the real app's four Today states.
// The screens copy the app's dark theme, measured from docs/web-screens (iPhone 17 Pro,
// 402 x 874 pt): every size in phone.css is that screen's points times --u.
// The device is deliberately generic (Apple's marketing guidelines: no notch or island,
// no volume buttons, no switch): a round camera dot and one plain side button.
import '../styles/phone.css';

interface Props {
  view: 'today' | 'write' | 'wait' | 'reveal';
  time?: string;
  date?: string;
  prompt?: string;
  partner?: string;
  mine?: string;
  theirs?: string;
  size?: 'centre' | 'pane';
}

const {
  view,
  time = '9:41',
  date = 'Monday · 16 November',
  prompt = 'What do they do that you have stopped noticing, and are glad of?',
  partner = 'Tunde',
  mine = "You waited up so I wouldn't walk home alone.",
  theirs = 'You made tea before I asked.',
  size = 'centre',
} = Astro.props;

const waiting = `Yours is saved. When ${partner} writes theirs, you'll both see each other's.`;
const reactions: Array<[string, string]> = [
  ['❤️', 'Heart'],
  ['🙏', 'Thank you'],
  ['😊', 'Smile'],
  ['🥹', 'Moved'],
  ['🤝', 'Me too'],
];
const labels = {
  today: `Today, not yet written. ${prompt}`,
  write: `Writing: ${mine}`,
  wait: `Written. ${waiting}`,
  reveal: `You both wrote today. From ${partner}: ${theirs} From you: ${mine}`,
};
const label = (v: keyof typeof labels) => `The Mọyì app. ${labels[v]}`;
const hide = (name: string) => (name === view ? undefined : true);
---

<div
  class={`dev dev--${size}`}
  role="img"
  aria-label={label(view)}
  data-phone
  data-mine={mine}
  data-label-today={label('today')}
  data-label-write={label('write')}
  data-label-wait={label('wait')}
  data-label-reveal={label('reveal')}
>
  <div class="dev__edge"></div>
  <div class="dev__body">
    <i class="dev__key"></i>
    <div class="dev__bezel">
      <div class="scr">
        <div class="ui">
        <div class="sb">
          <span class="clock">{time}</span>
          <i class="cam"></i>
          <svg class="sys" viewBox="0 0 78 13" aria-hidden="true">
            <rect x="0" y="8.5" width="3.2" height="4" rx=".9" />
            <rect x="5.1" y="6" width="3.2" height="6.5" rx=".9" />
            <rect x="10.2" y="3.3" width="3.2" height="9.2" rx=".9" />
            <rect x="15.3" y=".5" width="3.2" height="12" rx=".9" />
            <path d="M35.5 12.6l2.4-2.5a3.4 3.4 0 0 0-4.8 0zM31.3 8.3l1.2 1.2a4.3 4.3 0 0 1 6 0l1.2-1.2a6 6 0 0 0-8.4 0zM28.6 5.6l1.2 1.2a8.1 8.1 0 0 1 11.4 0l1.2-1.2a9.8 9.8 0 0 0-13.8 0z" />
            <rect class="bo" x="51.2" y=".9" width="23.6" height="11.2" rx="3.4" />
            <rect x="53" y="2.7" width="20" height="7.6" rx="2" />
            <path d="M76.2 4.6v3.8c.8-.3 1.3-1 1.3-1.9s-.5-1.6-1.3-1.9z" />
          </svg>
        </div>

        <div class="v v--today" data-view="today" hidden={hide('today')}>
          <div class="hd">
            <span class="dt">{date}</span>
            <span class="ic">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.9" y="4.4" width="18.2" height="16.6" rx="3" /><path d="M2.9 9.6h18.2M7.6 2.6v3.4M16.4 2.6v3.4" /></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 2.5h3.4l.6 2.7 1.6.9 2.6-.9 1.7 3-2 1.8v1.9l2 1.8-1.7 3-2.6-.9-1.6.9-.6 2.7h-3.4l-.6-2.7-1.6-.9-2.6.9-1.7-3 2-1.8v-1.9l-2-1.8 1.7-3 2.6.9 1.6-.9z" /><circle cx="12" cy="12" r="3.1" /></svg>
            </span>
          </div>
          <p class="pr">{prompt}</p>
          <span class="pa">Write</span>
        </div>

        <div class="v v--write" data-view="write" hidden={hide('write')}>
          <div class="hd"><span class="cn">Cancel</span></div>
          <div class="cf">
            <p class="cq">{prompt}<svg class="x" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 4.5l15 15M19.5 4.5l-15 15" /></svg></p>
            <p class="en"><span data-typed>{mine}</span><i class="ca"></i></p>
            <span class="md">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="2.6" /><circle cx="8.3" cy="8.3" r="1.9" /><path d="M2.5 18.6l6.2-6.2 5 5M12.4 16.1l3.2-3.2 5.9 5.9" /></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8.2" y="1.8" width="7.6" height="13.2" rx="3.8" /><path d="M4.7 11.2a7.3 7.3 0 0 0 14.6 0M12 18.5v3.9" /></svg>
            </span>
          </div>
          <span class="pa" data-send>Send</span>
        </div>

        <div class="v v--wait" data-view="wait" hidden={hide('wait')}>
          <div class="hd">
            <span class="dt">{date}</span>
            <span class="ic">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.9" y="4.4" width="18.2" height="16.6" rx="3" /><path d="M2.9 9.6h18.2M7.6 2.6v3.4M16.4 2.6v3.4" /></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 2.5h3.4l.6 2.7 1.6.9 2.6-.9 1.7 3-2 1.8v1.9l2 1.8-1.7 3-2.6-.9-1.6.9-.6 2.7h-3.4l-.6-2.7-1.6-.9-2.6.9-1.7-3 2-1.8v-1.9l-2-1.8 1.7-3 2.6.9 1.6-.9z" /><circle cx="12" cy="12" r="3.1" /></svg>
            </span>
          </div>
          <div class="ec">
            <p class="lb">From you<i class="mo"></i></p>
            <p class="en">{mine}</p>
          </div>
          <p class="wr">Written.</p>
          <p class="st">{waiting}</p>
        </div>

        <div class="v v--reveal" data-view="reveal" hidden={hide('reveal')}>
          <div class="hd">
            <span class="dt">{date}</span>
            <span class="ic">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.9" y="4.4" width="18.2" height="16.6" rx="3" /><path d="M2.9 9.6h18.2M7.6 2.6v3.4M16.4 2.6v3.4" /></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 2.5h3.4l.6 2.7 1.6.9 2.6-.9 1.7 3-2 1.8v1.9l2 1.8-1.7 3-2.6-.9-1.6.9-.6 2.7h-3.4l-.6-2.7-1.6-.9-2.6.9-1.7-3 2-1.8v-1.9l-2-1.8 1.7-3 2.6.9 1.6-.9z" /><circle cx="12" cy="12" r="3.1" /></svg>
            </span>
          </div>
          <p class="wr bo">You both wrote today.</p>
          <div class="rv" data-card="0">
            <div class="ec">
              <p class="lb">From {partner}</p>
              <p class="en">{theirs}</p>
            </div>
            <p class="st">React to what {partner} wrote.</p>
            <ul class="ch">{reactions.map(([e, w]) => <li><span>{e}</span>{w}</li>)}</ul>
          </div>
          <div class="ec" data-card="1">
            <p class="lb">From you<i class="mo"></i></p>
            <p class="en">{mine}</p>
          </div>
        </div>

        </div>
        <div class="glass"></div>
      </div>
    </div>
  </div>
</div>

---
import Base from '../layouts/Base.astro';
import Brand from './Brand.astro';
import '../styles/functional.css';

interface Props {
  kind: 'verify' | 'reset' | 'invite';
  heading: string;
  note: string;
}

const { kind, heading, note } = Astro.props;
---
<Base title={`${heading} · Mọyì`} noindex bodyAttrs={{ 'data-link': kind }}>
  <main>
    <Brand />
    <h1>{heading}</h1>
    <div id="found">
      <p><slot name="intro" /></p>
      <div class="card">
        <p class="label">Code</p>
        <code id="value"></code>
        <button type="button" data-copy="value">Copy code</button>
      </div>
      <div class="card">
        <p class="label">Command</p>
        <code id="command"></code>
        <button type="button" data-copy="command">Copy command</button>
      </div>
      <p class="note">{note}</p>
    </div>
    <div id="missing" hidden>
      <p>This link looks incomplete. Open it again from the email, or copy the whole link, including everything after the last <code class="inline">=</code> or <code class="inline">/</code>.</p>
    </div>
    <noscript><p>This page needs JavaScript to read the code from its own address. Nothing is sent anywhere.</p></noscript>
  </main>
  <script is:inline src="/link.js"></script>
</Base>

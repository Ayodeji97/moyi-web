---
import Base from '../layouts/Base.astro';
import Brand from './Brand.astro';
import '../styles/functional.css';

// The page a phone shows when an emailed or shared link did not open the app
// (moyi-backend #207, ported 2026-11-16). public/link.js fills #open and #value
// and reveals #found, so without JavaScript only the noscript line shows.
interface Props {
  kind: 'verify' | 'reset' | 'invite';
  heading: string;
  copyLabel: 'Copy link' | 'Copy code';
  note: string;
  where: 'email' | 'message';
  last: '=' | '/';
}

const { kind, heading, copyLabel, note, where, last } = Astro.props;
---
<Base title={`${heading} · Mọyì`} noindex bodyAttrs={{ 'data-link': kind }}>
  <main>
    <Brand />
    <h1>{heading}</h1>
    <div id="found" hidden>
      <p><slot name="intro" /></p>
      <p><a id="open" class="action" href="/">Open in the Mọyì app</a></p>
      <p class="note">If the app doesn't open, it may not be on this phone yet. On a computer, open the {where} on your phone instead.</p>
      <h2>Don't have the app yet?</h2>
      <p>Mọyì is coming soon to the App Store and Google Play.</p>
      <h2>If the button doesn't work</h2>
      <p><slot name="by-hand" /></p>
      <div class="card">
        <code id="value"></code>
        <button type="button" data-copy="value">{copyLabel}</button>
      </div>
      <p class="note">{note}</p>
    </div>
    <div id="missing" hidden>
      <p>This link looks incomplete. Open it again from the {where}, or copy the whole link, including everything after the last <code class="inline">{last}</code>.</p>
    </div>
    <noscript><p>This page needs JavaScript to read the link from its own address. Nothing is sent anywhere.</p></noscript>
  </main>
  <script is:inline src="/link.js"></script>
</Base>

# default-src 'none' is what makes these pages fetch nothing: no request to the
# API, no font, no analytics. A token or code leaves the page only by being
# copied (ADR-0018; link.js).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# The home page and the content pages need the self-hosted font; the home page
# also plays its own footage. Every matching rule applies, so each of these
# detaches the strict policy set by /* and sets its own: a page never carries
# two policies, and an unknown address keeps the strict one.
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
